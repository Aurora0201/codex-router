{
  "name": "@aurora0201/codex-router",
  "version": "0.2.1",
  "description": "A loopback-only account router and transparent proxy for Codex CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aurora0201/codex-router.git"
  },
  "homepage": "https://github.com/Aurora0201/codex-router#readme",
  "bugs": "https://github.com/Aurora0201/codex-router/issues",
  "keywords": [
    "codex",
    "openai",
    "gateway",
    "proxy"
  ],
  "type": "module",
  "bin": {
    "codex-router": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run test/gateway.e2e.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@inquirer/select": "^5.2.5",
    "@openai/codex": "^0.160.0",
    "@streamparser/json": "0.0.26",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "fastify": "^5.12.5",
    "open": "11.0.4",
    "undici": "^8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2"
  }
}
